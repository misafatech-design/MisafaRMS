rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'misafatech@gmail.com'
      );
    }

    function isOwnerUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBusinessOwner(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    // Validation helpers
    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'displayName', 'accountType', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'accountType', 'activeBusinessId', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.accountType in ['admin', 'employee', 'user'] &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('activeBusinessId' in data) || (data.activeBusinessId is string && data.activeBusinessId.size() <= 128)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidPrivateProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'phone', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidBusiness(data) {
      return data.keys().hasAll(['id', 'ownerId', 'slug', 'name', 'country', 'currency', 'taxPin', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'ownerName', 'ownerEmail', 'slug', 'name', 'country', 'currency', 'taxAuthority',
          'taxPin', 'vatRate', 'etimsEnabled', 'etimsMode', 'paybillOrTill',
          'subscriptionPlan', 'subscriptionStatus', 'monthlyFee', 'branchLimit', 'subscriptionRenewsAt',
          'ecommerceEnabled', 'customDomain', 'domainVerified', 'dnsToken', 'storefrontTagline',
          'deliveryFee', 'freeDeliveryAbove', 'storefrontPickupEnabled',
          'installedModuleIds', 'posConfig', 'paymentGateways', 'layoutConfig',
          'catalogTaxonomy', 'offers', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 100)) &&
        (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 160)) &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 64 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.country in ['KE', 'UG', 'TZ', 'GB', 'US'] &&
        data.currency in ['KES', 'UGX', 'TZS', 'GBP', 'USD'] &&
        data.taxPin is string && data.taxPin.size() >= 3 && data.taxPin.size() <= 40 &&
        (!('vatRate' in data) || (data.vatRate is number && data.vatRate >= 0 && data.vatRate <= 50)) &&
        (!('etimsEnabled' in data) || data.etimsEnabled is bool) &&
        (!('etimsMode' in data) || data.etimsMode in ['OSCU', 'VSCU', 'Standard']) &&
        (!('taxAuthority' in data) || (data.taxAuthority is string && data.taxAuthority.size() <= 100)) &&
        (!('paybillOrTill' in data) || (data.paybillOrTill is string && data.paybillOrTill.size() <= 120)) &&
        (!('subscriptionPlan' in data) || data.subscriptionPlan in ['Trial', 'Starter', 'Multi-Store Pro', 'Enterprise']) &&
        (!('subscriptionStatus' in data) || data.subscriptionStatus in ['active', 'trial', 'past_due', 'suspended']) &&
        (!('monthlyFee' in data) || (data.monthlyFee is number && data.monthlyFee >= 0)) &&
        (!('branchLimit' in data) || (data.branchLimit is number && data.branchLimit >= 1)) &&
        (!('subscriptionRenewsAt' in data) || (data.subscriptionRenewsAt is string && data.subscriptionRenewsAt.size() <= 40)) &&
        (!('ecommerceEnabled' in data) || data.ecommerceEnabled is bool) &&
        (!('customDomain' in data) || (data.customDomain is string && data.customDomain.size() <= 120)) &&
        (!('domainVerified' in data) || data.domainVerified is bool) &&
        (!('dnsToken' in data) || (data.dnsToken is string && data.dnsToken.size() <= 80)) &&
        (!('storefrontTagline' in data) || (data.storefrontTagline is string && data.storefrontTagline.size() <= 200)) &&
        (!('deliveryFee' in data) || (data.deliveryFee is number && data.deliveryFee >= 0)) &&
        (!('freeDeliveryAbove' in data) || (data.freeDeliveryAbove is number && data.freeDeliveryAbove >= 0)) &&
        (!('storefrontPickupEnabled' in data) || data.storefrontPickupEnabled is bool) &&
        (!('installedModuleIds' in data) || (data.installedModuleIds is list && data.installedModuleIds.size() <= 80 && (data.installedModuleIds.size() == 0 || data.installedModuleIds[0] is string))) &&
        (!('posConfig' in data) || data.posConfig is map) &&
        (!('paymentGateways' in data) || data.paymentGateways is list) &&
        (!('layoutConfig' in data) || data.layoutConfig is map) &&
        (!('catalogTaxonomy' in data) || (data.catalogTaxonomy is list && data.catalogTaxonomy.size() <= 100)) &&
        (!('offers' in data) || (data.offers is list && data.offers.size() <= 100)) &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidPlatformUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'tier', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'name', 'email', 'tier', 'role', 'businessId', 'businessName',
          'businessSlug', 'status', 'emailVerified', 'lastActiveAt', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.tier in ['super_admin', 'admin', 'employee', 'user'] &&
        data.status in ['active', 'suspended'] &&
        (!('role' in data) || (data.role is string && data.role.size() <= 60)) &&
        (!('businessId' in data) || (data.businessId is string && data.businessId.size() <= 128)) &&
        (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 120)) &&
        (!('businessSlug' in data) || (data.businessSlug is string && data.businessSlug.size() <= 64)) &&
        (!('emailVerified' in data) || data.emailVerified is bool) &&
        (!('lastActiveAt' in data) || (data.lastActiveAt is string && data.lastActiveAt.size() <= 40)) &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidPlatformBillingGateway(data) {
      return data.keys().hasAll(['id', 'provider', 'displayName', 'enabled', 'mode']) &&
        data.keys().hasOnly([
          'id', 'provider', 'displayName', 'enabled', 'mode', 'shortcodeOrAccount',
          'accountPrefix', 'currencies', 'environment', 'webhookUrl', 'hasSecretConfigured',
          'settlementSchedule', 'instructions'
        ]) &&
        isValidId(data.id) &&
        data.provider is string && data.provider.size() >= 1 && data.provider.size() <= 60 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.enabled is bool &&
        data.mode is string && data.mode.size() >= 1 && data.mode.size() <= 60 &&
        (!('shortcodeOrAccount' in data) || (data.shortcodeOrAccount is string && data.shortcodeOrAccount.size() <= 80)) &&
        (!('accountPrefix' in data) || (data.accountPrefix is string && data.accountPrefix.size() <= 40)) &&
        (!('currencies' in data) || (data.currencies is list && data.currencies.size() <= 20)) &&
        (!('environment' in data) || data.environment in ['Production', 'Sandbox']) &&
        (!('webhookUrl' in data) || (data.webhookUrl is string && data.webhookUrl.size() <= 240)) &&
        (!('hasSecretConfigured' in data) || data.hasSecretConfigured is bool) &&
        (!('settlementSchedule' in data) || (data.settlementSchedule is string && data.settlementSchedule.size() <= 100)) &&
        (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 300));
    }

    function isValidSubscriptionInvoice(data) {
      return data.keys().hasAll(['id', 'invoiceNo', 'businessId', 'planId', 'amount', 'status', 'dueDate']) &&
        data.keys().hasOnly([
          'id', 'invoiceNo', 'businessId', 'businessName', 'businessSlug',
          'planId', 'amount', 'currency', 'status', 'paymentMethod', 'paymentRef',
          'periodLabel', 'dueDate', 'paidAt'
        ]) &&
        isValidId(data.id) &&
        data.invoiceNo is string && data.invoiceNo.size() >= 1 && data.invoiceNo.size() <= 60 &&
        data.businessId is string && data.businessId.size() >= 1 && data.businessId.size() <= 128 &&
        data.planId in ['Trial', 'Starter', 'Multi-Store Pro', 'Enterprise'] &&
        data.amount is number && data.amount >= 0 &&
        data.status in ['paid', 'pending', 'overdue'] &&
        data.dueDate is string && data.dueDate.size() <= 40 &&
        (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 120)) &&
        (!('businessSlug' in data) || (data.businessSlug is string && data.businessSlug.size() <= 64)) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
        (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 120)) &&
        (!('paymentRef' in data) || (data.paymentRef is string && data.paymentRef.size() <= 80)) &&
        (!('periodLabel' in data) || (data.periodLabel is string && data.periodLabel.size() <= 60)) &&
        (!('paidAt' in data) || (data.paidAt is string && data.paidAt.size() <= 40));
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'role', 'pinCode', 'branchId', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'name', 'role', 'pinCode', 'branchId', 'grossSalary', 'email', 'active',
          'clockedIn', 'lastClockInAt', 'lastClockOutAt', 'tipsEarned', 'ratingAvg', 'ratingCount', 'ordersHandled',
          'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.role in ['Owner', 'Store Manager', 'Cashier', 'Inventory Clerk', 'Accountant', 'Field Agent'] &&
        data.pinCode is string && data.pinCode.size() >= 4 && data.pinCode.size() <= 8 && data.pinCode.matches('^[0-9]{4,8}$') &&
        data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
        (!('grossSalary' in data) || (data.grossSalary is number && data.grossSalary >= 0)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('active' in data) || data.active is bool) &&
        (!('clockedIn' in data) || data.clockedIn is bool) &&
        (!('lastClockInAt' in data) || (data.lastClockInAt is string && data.lastClockInAt.size() <= 40)) &&
        (!('lastClockOutAt' in data) || (data.lastClockOutAt is string && data.lastClockOutAt.size() <= 40)) &&
        (!('tipsEarned' in data) || (data.tipsEarned is number && data.tipsEarned >= 0)) &&
        (!('ratingAvg' in data) || (data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5)) &&
        (!('ratingCount' in data) || (data.ratingCount is number && data.ratingCount >= 0)) &&
        (!('ordersHandled' in data) || (data.ordersHandled is number && data.ordersHandled >= 0)) &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'ownerId', 'sku', 'name', 'price', 'taxCode']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'businessId', 'sku', 'barcode', 'name', 'category', 'subCategory',
          'zoneId', 'slotId', 'shelfCode', 'price', 'cost', 'taxCode', 'unit', 'reorderPoint',
          'imageUrl', 'variants', 'stockByStore'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 60 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.price is number && data.price >= 0 &&
        data.taxCode in ['B_16', 'E_0', 'A_EXEMPT'] &&
        (!('businessId' in data) || (data.businessId is string && data.businessId.size() <= 128)) &&
        (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 60)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
        (!('subCategory' in data) || (data.subCategory is string && data.subCategory.size() <= 60)) &&
        (!('zoneId' in data) || (data.zoneId is string && data.zoneId.size() <= 128)) &&
        (!('slotId' in data) || (data.slotId is string && data.slotId.size() <= 128)) &&
        (!('shelfCode' in data) || (data.shelfCode is string && data.shelfCode.size() <= 60)) &&
        (!('cost' in data) || (data.cost is number && data.cost >= 0)) &&
        (!('unit' in data) || (data.unit is string && data.unit.size() <= 30)) &&
        (!('reorderPoint' in data) || data.reorderPoint is number) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 300)) &&
        (!('variants' in data) || (data.variants is list && data.variants.size() <= 20)) &&
        (!('stockByStore' in data) || data.stockByStore is map);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'ownerId', 'receiptNo', 'storeId', 'total', 'etimsCuin', 'etimsStatus', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'receiptNo', 'businessId', 'storeId', 'storeName', 'cashierRole',
          'cashierName', 'customerName', 'customerPin', 'customerPhone', 'customerEmail',
          'channel', 'paymentMethod', 'paymentRef', 'currency', 'subtotal', 'taxAmount',
          'discountTotal', 'offerName', 'offerDiscount', 'tipAmount', 'tableOrSlotLabel',
          'staffRating', 'total', 'amountTendered', 'changeDue', 'etimsCuin', 'etimsStatus',
          'etimsQrData', 'lines', 'createdAt', 'syncedAt', 'encryptedOffline', 'emailedTo'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.receiptNo is string && data.receiptNo.size() >= 1 && data.receiptNo.size() <= 60 &&
        data.storeId is string && data.storeId.size() >= 1 && data.storeId.size() <= 128 &&
        data.total is number &&
        data.etimsCuin is string && data.etimsCuin.size() >= 1 && data.etimsCuin.size() <= 80 &&
        data.etimsStatus in ['Transmitted', 'Queued Offline', 'Pending Retry', 'Credit Note'] &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('tipAmount' in data) || (data.tipAmount is number && data.tipAmount >= 0)) &&
        (!('offerDiscount' in data) || (data.offerDiscount is number && data.offerDiscount >= 0)) &&
        (!('staffRating' in data) || (data.staffRating is number && data.staffRating >= 1 && data.staffRating <= 5)) &&
        (!('lines' in data) || (data.lines is list && data.lines.size() <= 200));
    }

    function isValidErpRecord(data) {
      return data.keys().hasAll(['id', 'ownerId', 'moduleId', 'title', 'status', 'date']) &&
        data.keys().hasOnly(['id', 'ownerId', 'moduleId', 'businessId', 'title', 'subtitle', 'status', 'amount', 'currency', 'date', 'meta']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 60 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 60 &&
        data.date is string && data.date.size() <= 30 &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 240)) &&
        (!('amount' in data) || data.amount is number) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
        (!('meta' in data) || data.meta is map);
    }

    function isValidStoreBranch(data) {
      return data.keys().hasAll(['id', 'ownerId', 'businessId', 'name', 'code']) &&
        data.keys().hasOnly(['id', 'ownerId', 'businessId', 'name', 'code', 'location', 'etimsBhfId', 'vscuSerial', 'tillNumber', 'registerId', 'isActive']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidId(data.businessId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 20 &&
        (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
        (!('etimsBhfId' in data) || (data.etimsBhfId is string && data.etimsBhfId.size() <= 20)) &&
        (!('vscuSerial' in data) || (data.vscuSerial is string && data.vscuSerial.size() <= 60)) &&
        (!('tillNumber' in data) || (data.tillNumber is string && data.tillNumber.size() <= 80)) &&
        (!('registerId' in data) || (data.registerId is string && data.registerId.size() <= 40)) &&
        (!('isActive' in data) || data.isActive is bool);
    }

    function isValidTaxInvoice(data) {
      return data.keys().hasAll(['id', 'ownerId', 'invoiceNo', 'status', 'total', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'invoiceNo', 'businessId', 'storeId', 'storeName', 'customerName',
          'customerEmail', 'customerPhone', 'customerPin', 'docType', 'status', 'currency',
          'lines', 'subtotal', 'taxAmount', 'total', 'amountPaid', 'balanceDue', 'dueDate',
          'etimsCuin', 'linkedTransactionId', 'createdAt', 'paidAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.invoiceNo is string && data.invoiceNo.size() >= 1 && data.invoiceNo.size() <= 60 &&
        data.status in ['Draft', 'Unpaid', 'Partial', 'Paid', 'Void'] &&
        data.total is number && data.total >= 0 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('lines' in data) || (data.lines is list && data.lines.size() <= 200));
    }

    function isValidOnlineOrder(data) {
      return data.keys().hasAll(['id', 'ownerId', 'orderNo', 'fulfillmentStatus', 'total', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'orderNo', 'businessId', 'storeId', 'storeName', 'customerName',
          'customerPhone', 'customerEmail', 'customerPin', 'deliveryMethod', 'deliveryAddress',
          'fulfillmentStatus', 'paymentMethod', 'paymentRef', 'paymentStatus', 'currency',
          'subtotal', 'taxAmount', 'deliveryFee', 'total', 'lines', 'linkedTransactionId',
          'linkedInvoiceId', 'etimsCuin', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.orderNo is string && data.orderNo.size() >= 1 && data.orderNo.size() <= 60 &&
        data.fulfillmentStatus in ['Pending', 'Confirmed & Packed', 'Dispatched', 'Delivered', 'Cancelled'] &&
        data.total is number && data.total >= 0 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('lines' in data) || (data.lines is list && data.lines.size() <= 200));
    }

    function isValidCrmLead(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'stage', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'businessId', 'name', 'company', 'email', 'phone',
          'kraPin', 'stage', 'expectedValue', 'notes', 'source', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.stage in ['Lead', 'Qualified', 'Proposal', 'Won', 'Customer'] &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidPayrollRun(data) {
      return data.keys().hasAll(['id', 'ownerId', 'periodLabel', 'totalNet', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'businessId', 'periodLabel', 'employeeCount', 'currency',
          'totalGross', 'totalPaye', 'totalShif', 'totalNssf', 'totalHousingLevy',
          'totalNet', 'totalEmployerCost', 'status', 'payslips', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.periodLabel is string && data.periodLabel.size() >= 1 && data.periodLabel.size() <= 60 &&
        data.totalNet is number && data.totalNet >= 0 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('payslips' in data) || (data.payslips is list && data.payslips.size() <= 500));
    }

    function isValidBackupSnapshot(data) {
      return data.keys().hasAll(['id', 'ownerId', 'label', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'businessId', 'scope', 'label', 'createdBy',
          'createdAt', 'sizeBytes', 'counts', 'payload'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('counts' in data) || data.counts is map) &&
        (!('payload' in data) || data.payload is map);
    }

    // Connection test doc
    match /test/connection {
      allow get: if isSignedIn();
    }

    // Admin registry
    match /admins/{userId} {
      allow get: if isOwnerUid(userId) || isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(userId);
    }

    // Super Admin Software Users Directory (PII isolated to Super Admin only)
    match /platformUsers/{userId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(userId) && isValidPlatformUser(incoming());
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Super Admin SaaS Subscription Payment Gateways (read by signed-in business owners for checkout, write only by Super Admin)
    match /platformBillingGateways/{gatewayId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(gatewayId) && isValidPlatformBillingGateway(incoming());
      allow delete: if isAdmin() && isValidId(gatewayId);
    }

    // SaaS Subscription Invoices
    match /subscriptionInvoices/{invoiceId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(invoiceId) && isValidSubscriptionInvoice(incoming());
      allow delete: if isAdmin() && isValidId(invoiceId);
    }

    // User accounts & isolated private PII
    match /users/{userId} {
      allow get: if isOwnerUid(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwnerUid(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == request.auth.uid &&
        (incoming().accountType in ['employee', 'user'] || isAdmin());
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (isOwnerUid(userId) && incoming().accountType == existing().accountType && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'activeBusinessId', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);

      match /private/{docId} {
        allow get: if (isOwnerUid(userId) || isAdmin()) && isValidId(docId);
        allow create, update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          (isOwnerUid(userId) || isAdmin()) &&
          isValidPrivateProfile(incoming()) &&
          incoming().uid == userId;
        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }
    }

    // Multi-tenant Businesses
    match /businesses/{businessId} {
      allow get: if isSignedIn() && isValidId(businessId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(businessId) &&
        isValidBusiness(incoming()) &&
        incoming().ownerId == request.auth.uid;
      allow update: if isVerifiedUser() &&
        isValidId(businessId) &&
        isValidBusiness(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'taxPin', 'vatRate', 'etimsEnabled', 'etimsMode', 'paybillOrTill', 'ecommerceEnabled', 'customDomain', 'domainVerified', 'dnsToken', 'storefrontTagline', 'deliveryFee', 'freeDeliveryAbove', 'storefrontPickupEnabled', 'installedModuleIds', 'posConfig', 'paymentGateways', 'layoutConfig', 'catalogTaxonomy', 'offers', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(businessId);

      // Employees subcollection
      match /employees/{employeeId} {
        allow get: if isSignedIn() && isValidId(employeeId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(employeeId) &&
          isValidEmployee(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          isBusinessOwner(businessId);
        allow update: if isVerifiedUser() &&
          isValidId(employeeId) &&
          isValidEmployee(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          (isAdmin() || (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'pinCode', 'branchId', 'grossSalary', 'email', 'active', 'clockedIn', 'lastClockInAt', 'lastClockOutAt', 'tipsEarned', 'ratingAvg', 'ratingCount', 'ordersHandled'])));
        allow delete: if isVerifiedUser() && isValidId(employeeId) && (existing().ownerId == request.auth.uid || isAdmin());
      }

      // Products subcollection
      match /products/{productId} {
        allow get: if isSignedIn() && isValidId(productId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(productId) &&
          isValidProduct(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          isBusinessOwner(businessId);
        allow update: if isVerifiedUser() &&
          isValidId(productId) &&
          isValidProduct(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          (isAdmin() || (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'price', 'cost', 'taxCode', 'category', 'subCategory', 'zoneId', 'slotId', 'shelfCode', 'reorderPoint', 'stockByStore', 'variants'])));
        allow delete: if isVerifiedUser() && isValidId(productId) && (existing().ownerId == request.auth.uid || isAdmin());
      }

      // Transactions subcollection
      match /transactions/{txId} {
        allow get: if isSignedIn() && isValidId(txId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(txId) &&
          isValidTransaction(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          isBusinessOwner(businessId);
        allow update: if isVerifiedUser() &&
          isValidId(txId) &&
          isValidTransaction(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          (
            isAdmin() ||
            (existing().ownerId == request.auth.uid && existing().etimsStatus != 'Transmitted' && incoming().diff(existing()).affectedKeys().hasOnly(['etimsStatus', 'syncedAt', 'emailedTo', 'etimsCuin']))
          );
        allow delete: if isAdmin() && isValidId(txId);
      }

      // ERP Module Records subcollection
      match /erpRecords/{recordId} {
        allow get: if isSignedIn() && isValidId(recordId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(recordId) &&
          isValidErpRecord(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          isBusinessOwner(businessId);
        allow update: if isVerifiedUser() &&
          isValidId(recordId) &&
          isValidErpRecord(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          (isAdmin() || (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subtitle', 'status', 'amount', 'meta'])));
        allow delete: if isVerifiedUser() && isValidId(recordId) && (existing().ownerId == request.auth.uid || isAdmin());
      }

      // Stores subcollection
      match /stores/{storeId} {
        allow get: if isSignedIn() && isValidId(storeId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() && isValidId(storeId) && isValidStoreBranch(incoming()) && incoming().ownerId == request.auth.uid && isBusinessOwner(businessId);
        allow update: if isVerifiedUser() && isValidId(storeId) && isValidStoreBranch(incoming()) && incoming().ownerId == existing().ownerId && (isAdmin() || existing().ownerId == request.auth.uid);
        allow delete: if isVerifiedUser() && isValidId(storeId) && (existing().ownerId == request.auth.uid || isAdmin());
      }

      // Invoices subcollection
      match /invoices/{invoiceId} {
        allow get: if isSignedIn() && isValidId(invoiceId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() && isValidId(invoiceId) && isValidTaxInvoice(incoming()) && incoming().ownerId == request.auth.uid && isBusinessOwner(businessId);
        allow update: if isVerifiedUser() && isValidId(invoiceId) && isValidTaxInvoice(incoming()) && incoming().ownerId == existing().ownerId && (isAdmin() || existing().ownerId == request.auth.uid);
        allow delete: if isVerifiedUser() && isValidId(invoiceId) && (existing().ownerId == request.auth.uid || isAdmin());
      }

      // Online Orders subcollection
      match /onlineOrders/{orderId} {
        allow get: if isSignedIn() && isValidId(orderId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() && isValidId(orderId) && isValidOnlineOrder(incoming()) && incoming().ownerId == request.auth.uid && isBusinessOwner(businessId);
        allow update: if isVerifiedUser() && isValidId(orderId) && isValidOnlineOrder(incoming()) && incoming().ownerId == existing().ownerId && (isAdmin() || existing().ownerId == request.auth.uid);
        allow delete: if isVerifiedUser() && isValidId(orderId) && (existing().ownerId == request.auth.uid || isAdmin());
      }

      // CRM Leads subcollection
      match /crmLeads/{leadId} {
        allow get: if isSignedIn() && isValidId(leadId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() && isValidId(leadId) && isValidCrmLead(incoming()) && incoming().ownerId == request.auth.uid && isBusinessOwner(businessId);
        allow update: if isVerifiedUser() && isValidId(leadId) && isValidCrmLead(incoming()) && incoming().ownerId == existing().ownerId && (isAdmin() || existing().ownerId == request.auth.uid);
        allow delete: if isVerifiedUser() && isValidId(leadId) && (existing().ownerId == request.auth.uid || isAdmin());
      }

      // Payroll Runs subcollection
      match /payrollRuns/{runId} {
        allow get: if isSignedIn() && isValidId(runId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() && isValidId(runId) && isValidPayrollRun(incoming()) && incoming().ownerId == request.auth.uid && isBusinessOwner(businessId);
        allow update: if isVerifiedUser() && isValidId(runId) && isValidPayrollRun(incoming()) && incoming().ownerId == existing().ownerId && (isAdmin() || existing().ownerId == request.auth.uid);
        allow delete: if isVerifiedUser() && isValidId(runId) && (existing().ownerId == request.auth.uid || isAdmin());
      }

      // Backups subcollection
      match /backups/{backupId} {
        allow get: if isSignedIn() && isValidId(backupId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() && isValidId(backupId) && isValidBackupSnapshot(incoming()) && incoming().ownerId == request.auth.uid && isBusinessOwner(businessId);
        allow update: if isVerifiedUser() && isValidId(backupId) && isValidBackupSnapshot(incoming()) && incoming().ownerId == existing().ownerId && (isAdmin() || existing().ownerId == request.auth.uid);
        allow delete: if isVerifiedUser() && isValidId(backupId) && (existing().ownerId == request.auth.uid || isAdmin());
      }
    }
  }
}
